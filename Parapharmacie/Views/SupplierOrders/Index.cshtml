@model IEnumerable<Parapharmacie.Models.SupplierOrder>
@{
    ViewData["Title"] = "Commandes fournisseurs";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Commandes fournisseurs</h2>
    <a class="btn btn-primary" asp-action="Create">Nouvelle commande</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Date</th>
            <th>Fournisseur</th>
            <th>Statut</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            var supplier = Parapharmacie.Data.InMemoryData.Suppliers.FirstOrDefault(s => s.Id == order.SupplierId);
            <tr>
                <td>@order.OrderDate.ToLocalTime().ToString("g")</td>
                <td>@supplier?.Name</td>
                <td>@order.Status</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@order.Id">Détails</a>
                </td>
            </tr>
        }
    </tbody>
</table>




