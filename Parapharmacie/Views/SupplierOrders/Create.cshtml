@model Parapharmacie.ViewModels.SupplierOrderCreateViewModel
@{
    ViewData["Title"] = "Nouvelle commande fournisseur";
    var suppliers = ViewBag.Suppliers as IEnumerable<Parapharmacie.Models.Supplier> ?? new List<Parapharmacie.Models.Supplier>();
    var products = ViewBag.Products as IEnumerable<Parapharmacie.Models.Product> ?? new List<Parapharmacie.Models.Product>();
}

<h2>Nouvelle commande fournisseur</h2>

<form asp-action="Create" method="post" class="mt-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Fournisseur</label>
        <select asp-for="SupplierId" class="form-select">
            <option value="">-- Choisir --</option>
            @foreach (var s in suppliers)
            {
                <option value="@s.Id">@s.Name</option>
            }
        </select>
        <span asp-validation-for="SupplierId" class="text-danger"></span>
    </div>

    <h5>Produits</h5>
    <table class="table" id="items-table">
        <thead>
            <tr>
                <th>Produit</th>
                <th style="width:140px">Quantité</th>
                <th style="width:80px"></th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Items.Count; i++)
            {
                <tr>
                    <td>
                        <select name="Items[@i].ProductId" class="form-select">
                            @foreach (var p in products)
                            {
                                <option value="@p.Id" selected="@(p.Id == Model.Items[i].ProductId)">@p.Name</option>
                            }
                        </select>
                    </td>
                    <td><input name="Items[@i].Quantity" class="form-control" type="number" min="1" value="@Model.Items[i].Quantity" /></td>
                    <td><button type="button" class="btn btn-link text-danger" onclick="removeRow(this)">Supprimer</button></td>
                </tr>
            }
        </tbody>
    </table>
    <button type="button" class="btn btn-outline-primary" onclick="addRow()">Ajouter une ligne</button>

    <div class="mt-3">
        <button class="btn btn-primary">Enregistrer</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Annuler</a>
    </div>
</form>

<template id="row-template">
    <tr>
        <td>
            <select class="form-select product-select">
                @foreach (var p in products)
                {
                    <option value="@p.Id">@p.Name</option>
                }
            </select>
        </td>
        <td><input class="form-control qty-input" type="number" min="1" value="1" /></td>
        <td><button type="button" class="btn btn-link text-danger" onclick="removeRow(this)">Supprimer</button></td>
    </tr>
</template>

@section Scripts{
    <script>
        function addRow() {
            const tbody = document.querySelector('#items-table tbody');
            const tpl = document.querySelector('#row-template').content.cloneNode(true);
            tbody.appendChild(tpl);
            renumber();
        }
        function removeRow(btn) {
            btn.closest('tr').remove();
            renumber();
        }
        function renumber() {
            document.querySelectorAll('#items-table tbody tr').forEach((row, idx) => {
                row.querySelector('select').name = `Items[${idx}].ProductId`;
                row.querySelector('.qty-input')?.setAttribute('name', `Items[${idx}].Quantity`);
                const qty = row.querySelector('.qty-input') || row.querySelector('input[type="number"]');
                qty.name = `Items[${idx}].Quantity`;
            });
        }
        document.addEventListener('DOMContentLoaded', renumber);
    </script>
}

