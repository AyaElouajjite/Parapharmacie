@{
    ViewData["Title"] = "Mon espace client";
    var customer = ViewBag.Customer as Parapharmacie.Models.Customer;
    var purchases = ViewBag.Purchases as IEnumerable<Parapharmacie.Models.Sale> ?? new List<Parapharmacie.Models.Sale>();
}

<h2>Mon espace</h2>
<p><strong>Client :</strong> @customer?.FullName</p>
<p><strong>Points fidélité :</strong> @customer?.LoyaltyPoints</p>

<a class="btn btn-primary mb-3" asp-action="Commande">Effectuer une commande</a>

<h4>Historique des achats</h4>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Date</th>
            <th>Total</th>
            <th>Détails</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var sale in purchases)
        {
            <tr>
                <td>@sale.Date.ToLocalTime().ToString("g")</td>
                <td>@sale.Total.ToString("0.00") €</td>
                <td>
                    <ul class="mb-0">
                        @foreach (var item in sale.Items)
                        {
                            <li>@item.Product?.Name x @item.Quantity (@item.LineTotal.ToString("0.00") €)</li>
                        }
                    </ul>
                </td>
            </tr>
        }
        @if (!purchases.Any())
        {
            <tr><td colspan="3">Aucun achat pour le moment.</td></tr>
        }
    </tbody>
</table>




