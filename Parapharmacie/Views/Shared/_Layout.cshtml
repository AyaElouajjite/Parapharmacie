<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Parapharmacie</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Parapharmacie.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Parapharmacie</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Accueil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Catalog" asp-action="Index">Catalogue</a>
                        </li>
                        @{
                            var role = Context.Session.GetString("Role");
                        }
                        @if (role == "Admin" || role == "Gerant")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Products" asp-action="Index">Gestion Produits</a>
                            </li>
                        }
                        @if (role == "Admin" || role == "Caissier" || role == "Gerant")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Sales" asp-action="Index">Ventes</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Customers" asp-action="Index">Clients</a>
                            </li>
                        }
                        @if (role == "Gerant")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="SupplierOrders" asp-action="Index">Commandes fournisseurs</a>
                            </li>
                        }
                        @if (role == "Supplier")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="SupplierOrders" asp-action="Index">Mes commandes</a>
                            </li>
                        }
                        @if (role == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Categories" asp-action="Index">Catégories</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Users" asp-action="Index">Utilisateurs</a>
                            </li>
                        }
                        @if (role == "Client")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="ClientPortal" asp-action="Dashboard">Mon espace</a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center">
                        <a class="nav-link text-dark me-2" asp-controller="Cart" asp-action="Index">
                            🛒 Panier
                            @{
                                var cartJson = Context.Session.GetString("Cart");
                                if (!string.IsNullOrEmpty(cartJson))
                                {
                                    try
                                    {
                                        var cart = System.Text.Json.JsonSerializer.Deserialize<List<Parapharmacie.Models.CartItem>>(cartJson);
                                        if (cart != null && cart.Any())
                                        {
                                            <span class="badge bg-primary">@cart.Sum(c => c.Quantity)</span>
                                        }
                                    }
                                    catch { }
                                }
                            }
                        </a>
                        <div class="vr me-2" style="height: 20px;"></div>
                        @if (!string.IsNullOrEmpty(role))
                        {
                            <span class="navbar-text me-2">Connecté : @Context.Session.GetString("Username") (@role)</span>
                            <a class="btn btn-outline-secondary btn-sm" asp-controller="Account" asp-action="Logout">Déconnexion</a>
                        }
                        else
                        {
                            <a class="btn btn-primary btn-sm me-2" asp-controller="Account" asp-action="Login">Connexion</a>
                            <a class="btn btn-success btn-sm" asp-controller="Account" asp-action="Register">Inscription client</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Parapharmacie - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
