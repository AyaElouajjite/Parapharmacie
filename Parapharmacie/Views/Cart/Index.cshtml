@model IEnumerable<Parapharmacie.Models.CartItem>
@{
    ViewData["Title"] = "Mon panier";
    decimal total = 0;
}

<div class="container">
    <h1 class="mb-4 text-dark">Mon panier</h1>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <h4>Votre panier est vide</h4>
            <p>Découvrez nos produits et ajoutez-les à votre panier.</p>
            <a href="@Url.Action("Index", "Catalog")" class="btn btn-primary">Voir le catalogue</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Produit</th>
                            <th>Prix unitaire</th>
                            <th>Quantité</th>
                            <th>Total</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            if (item.Product != null)
                            {
                                var itemTotal = item.Product.Price * item.Quantity;
                                total += itemTotal;
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(item.Product.ImageUrl))
                                            {
                                                <img src="@item.Product.ImageUrl" alt="@item.Product.Name" class="img-thumbnail me-2" style="width: 60px; height: 60px; object-fit: cover;" />
                                            }
                                            <div>
                                                <strong>@item.Product.Name</strong>
                                                <br />
                                                <small class="text-muted">@item.Product.Reference</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@item.Product.Price.ToString("0.00") €</td>
                                    <td>
                                        <form method="post" asp-action="UpdateQuantity" class="d-inline">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <input type="number" name="quantity" value="@item.Quantity" min="1" max="@item.Product.Stock" class="form-control form-control-sm" style="width: 80px; display: inline-block;" onchange="this.form.submit()" />
                                        </form>
                                    </td>
                                    <td><strong>@itemTotal.ToString("0.00") €</strong></td>
                                    <td>
                                        <form method="post" asp-action="RemoveFromCart" class="d-inline">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <a href="@Url.Action("Index", "Catalog")" class="btn btn-outline-secondary">Continuer les achats</a>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Résumé de la commande</h5>
                        <hr />
                        <div class="d-flex justify-content-between mb-2">
                            <span>Sous-total:</span>
                            <span>@total.ToString("0.00") €</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>TVA (20%):</span>
                            <span>@((total * 0.20m).ToString("0.00")) €</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between mb-3">
                            <strong>Total:</strong>
                            <strong class="text-primary fs-5">@((total * 1.20m).ToString("0.00")) €</strong>
                        </div>
                        <a href="@Url.Action("Checkout", "Cart")" class="btn btn-primary w-100 btn-lg">Finaliser la commande</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

