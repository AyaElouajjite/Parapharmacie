@model Parapharmacie.Models.Product
@{
    ViewData["Title"] = "Détails produit";
}

<div class="row">
    <div class="col-md-4">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded shadow" onerror="this.src='https://via.placeholder.com/400x400?text=@Uri.EscapeDataString(Model.Name)'" />
        }
        else
        {
            <div class="bg-light d-flex align-items-center justify-content-center rounded shadow" style="height: 300px;">
                <span class="text-muted">Pas d'image disponible</span>
            </div>
        }
    </div>
    <div class="col-md-8">
        <h2 class="text-dark">@Model.Name</h2>
        <dl class="row">
            <dt class="col-sm-3">Référence</dt>
            <dd class="col-sm-9">@Model.Reference</dd>
            <dt class="col-sm-3">Prix</dt>
            <dd class="col-sm-9">@Model.Price.ToString("0.00") €</dd>
            <dt class="col-sm-3">Stock</dt>
            <dd class="col-sm-9">@Model.Stock</dd>
            <dt class="col-sm-3">Niveau alerte</dt>
            <dd class="col-sm-9">@Model.ReorderLevel</dd>
            @if (Model.CategoryId.HasValue)
            {
                var category = Parapharmacie.Data.InMemoryData.Categories.FirstOrDefault(c => c.Id == Model.CategoryId);
                if (category != null)
                {
                    <dt class="col-sm-3">Catégorie</dt>
                    <dd class="col-sm-9">@category.Name</dd>
                }
            }
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>
            }
        </dl>

        <div class="mt-3">
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Modifier</a>
            <a class="btn btn-outline-secondary" asp-action="Index">Retour</a>
        </div>
    </div>
</div>




