@model Parapharmacie.Models.Category
@{
    ViewData["Title"] = "Supprimer catégorie";
}

<h2>Supprimer</h2>
<p>Supprimer la catégorie <strong>@Model.Name</strong> ?</p>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button class="btn btn-danger">Supprimer</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Annuler</a>
</form>




