@model IEnumerable<Parapharmacie.Models.Category>
@{
    ViewData["Title"] = "Catégories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Catégories</h2>
    <a class="btn btn-primary" asp-action="Create">Nouvelle catégorie</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nom</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Name</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">Modifier</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@c.Id">Supprimer</a>
                </td>
            </tr>
        }
    </tbody>
</table>




