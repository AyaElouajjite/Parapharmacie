@model Parapharmacie.Models.Customer
@{
    ViewData["Title"] = "Supprimer client";
}

<h2>Supprimer</h2>
<p>Confirmer la suppression du client <strong>@Model.FullName</strong> ?</p>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button class="btn btn-danger">Supprimer</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Annuler</a>
</form>




