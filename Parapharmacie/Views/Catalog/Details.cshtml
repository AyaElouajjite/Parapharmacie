@model Parapharmacie.Models.Product
@{
    ViewData["Title"] = Model.Name;
}

<div class="container">
    <div class="row">
        <div class="col-md-6">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="img-fluid rounded shadow" alt="@Model.Name" onerror="this.src='https://via.placeholder.com/500x500?text=@Uri.EscapeDataString(Model.Name)'" />
            }
            else
            {
                <div class="bg-light d-flex align-items-center justify-content-center rounded shadow" style="height: 400px;">
                    <span class="text-muted">Pas d'image disponible</span>
                </div>
            }
        </div>
        <div class="col-md-6">
            <h1 class="text-dark">@Model.Name</h1>
            <p class="text-muted">Référence: @Model.Reference</p>
            <p class="display-6 text-primary">@Model.Price.ToString("0.00") €</p>
            
            <div class="mb-3">
                <h5 class="text-dark">Description</h5>
                <p>@(string.IsNullOrEmpty(Model.Description) ? "Aucune description disponible." : Model.Description)</p>
            </div>

            <div class="mb-3">
                <p><strong>Stock disponible:</strong> @Model.Stock</p>
                @if (Model.CategoryId.HasValue)
                {
                    var category = Parapharmacie.Data.InMemoryData.Categories.FirstOrDefault(c => c.Id == Model.CategoryId);
                    if (category != null)
                    {
                        <p><strong>Catégorie:</strong> @category.Name</p>
                    }
                }
            </div>

            @if (Model.Stock > 0)
            {
                <form method="post" asp-controller="Cart" asp-action="AddToCart" class="mb-3">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <div class="input-group" style="max-width: 300px;">
                        <input type="number" name="quantity" class="form-control" value="1" min="1" max="@Model.Stock" />
                        <button type="submit" class="btn btn-primary btn-lg">Ajouter au panier</button>
                    </div>
                </form>
            }
            else
            {
                <button class="btn btn-secondary btn-lg" disabled>Rupture de stock</button>
            }

            <div class="mt-3">
                <a href="@Url.Action("Index", "Catalog")" class="btn btn-outline-secondary">Retour au catalogue</a>
                <a href="@Url.Action("Index", "Cart")" class="btn btn-outline-primary">Voir le panier</a>
            </div>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show position-fixed top-0 end-0 m-3" role="alert" style="z-index: 1050;">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

