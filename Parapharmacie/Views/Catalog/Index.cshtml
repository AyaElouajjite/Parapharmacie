@model IEnumerable<Parapharmacie.Models.Product>
@{
    ViewData["Title"] = "Catalogue de produits";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-4 text-center mb-4 text-dark">Catalogue de produits</h1>
        </div>
    </div>

    <!-- Barre de recherche et filtres -->
    <div class="row mb-4">
        <div class="col-md-8">
            <form method="get" asp-action="Index" class="d-flex">
                <input type="text" name="search" class="form-control me-2" placeholder="Rechercher un produit..." value="@ViewBag.SearchTerm" />
                <button type="submit" class="btn btn-primary">Rechercher</button>
            </form>
        </div>
        <div class="col-md-4">
            <form method="get" asp-action="Index">
                <input type="hidden" name="search" value="@ViewBag.SearchTerm" />
                <select name="categoryId" class="form-select" onchange="this.form.submit()">
                    <option value="">Toutes les catégories</option>
                    @foreach (var cat in (IEnumerable<Parapharmacie.Models.Category>)ViewBag.Categories)
                    {
                        <option value="@cat.Id" selected="@(ViewBag.CategoryId != null && ViewBag.CategoryId == cat.Id)">@cat.Name</option>
                    }
                </select>
            </form>
        </div>
    </div>

    <!-- Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Grille de produits -->
    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="alert alert-info">Aucun produit trouvé.</div>
            </div>
        }
        else
        {
            @foreach (var product in Model)
            {
                <div class="col-md-4 col-lg-3 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 200px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/300x200?text=@Uri.EscapeDataString(product.Name)'" />
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                <span class="text-muted">Pas d'image</span>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@product.Name</h5>
                            <p class="card-text text-muted small">
                                @if (!string.IsNullOrEmpty(product.Description))
                                {
                                    @(product.Description.Length > 100 ? product.Description.Substring(0, 100) + "..." : product.Description)
                                }
                                else
                                {
                                    <span>Aucune description disponible.</span>
                                }
                            </p>
                            <div class="mt-auto">
                                <p class="card-text">
                                    <strong class="text-primary fs-4">@product.Price.ToString("0.00") €</strong>
                                </p>
                                <p class="card-text">
                                    <small class="text-muted">
                                        Stock disponible: <strong>@product.Stock</strong>
                                    </small>
                                </p>
                                @if (product.Stock > 0)
                                {
                                    <form method="post" asp-controller="Cart" asp-action="AddToCart" class="mt-2">
                                        <input type="hidden" name="productId" value="@product.Id" />
                                        <div class="input-group mb-2">
                                            <input type="number" name="quantity" class="form-control" value="1" min="1" max="@product.Stock" />
                                            <button type="submit" class="btn btn-primary">Ajouter au panier</button>
                                        </div>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-secondary" disabled>Rupture de stock</button>
                                }
                                <a href="@Url.Action("Details", "Catalog", new { id = product.Id })" class="btn btn-outline-secondary btn-sm w-100 mt-2">Voir détails</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

