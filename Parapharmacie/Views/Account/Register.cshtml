@{
    Layout = "_Layout";
    ViewData["Title"] = "Inscription client";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm glass-panel">
            <div class="card-body">
                <h2 class="mb-3">Créer un compte client</h2>
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }
                <form asp-action="Register" method="post">
                    <div class="mb-3">
                        <label class="form-label">Nom complet</label>
                        <input name="fullName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email (servira d'identifiant)</label>
                        <input name="email" type="email" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Téléphone</label>
                        <input name="phone" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mot de passe</label>
                        <input name="password" type="password" class="form-control" required />
                    </div>
                    <button class="btn btn-primary w-100">S'inscrire</button>
                    <div class="mt-3 text-center">
                        <a asp-action="Login">Déjà un compte ? Se connecter</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>




