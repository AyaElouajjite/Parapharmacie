@model IEnumerable<Parapharmacie.Models.User>
@{
    ViewData["Title"] = "Utilisateurs";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Utilisateurs</h2>
    <a class="btn btn-primary" asp-action="Create">Nouvel utilisateur</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Login</th>
            <th>Rôle</th>
            <th>Client/Supplier</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Username</td>
                <td>@u.Role</td>
                <td>
                    @if (u.CustomerId.HasValue) { <span>Client #@u.CustomerId</span> }
                    @if (u.SupplierId.HasValue) { <span> | Fournisseur #@u.SupplierId</span> }
                </td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@u.Id">Modifier</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@u.Id">Supprimer</a>
                </td>
            </tr>
        }
    </tbody>
</table>




