@model IEnumerable<Parapharmacie.Models.Sale>
@{
    ViewData["Title"] = "Ventes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Ventes</h2>
    <a class="btn btn-primary" asp-action="Create">Nouvelle vente</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Date</th>
            <th>Client</th>
            <th>Total</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var sale in Model)
        {
            <tr>
                <td>@sale.Date.ToLocalTime().ToString("g")</td>
                <td>
                    @{
                        var cust = sale.CustomerId.HasValue ? Parapharmacie.Data.InMemoryData.Customers.FirstOrDefault(c => c.Id == sale.CustomerId) : null;
                    }
                    @(cust?.FullName ?? "Visiteur")
                </td>
                <td>@sale.Total.ToString("0.00") €</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@sale.Id">Facture</a>
                </td>
            </tr>
        }
    </tbody>
</table>




