@{
    ViewData["Title"] = "Accueil";
    var role = Context.Session.GetString("Role");
    var products = ViewBag.Products as IEnumerable<Parapharmacie.Models.Product> ?? new List<Parapharmacie.Models.Product>();
    var sales = ViewBag.Sales as IEnumerable<Parapharmacie.Models.Sale> ?? new List<Parapharmacie.Models.Sale>();
    var customers = ViewBag.Customers as IEnumerable<Parapharmacie.Models.Customer> ?? new List<Parapharmacie.Models.Customer>();
    var supplierOrders = ViewBag.SupplierOrders as IEnumerable<Parapharmacie.Models.SupplierOrder> ?? new List<Parapharmacie.Models.SupplierOrder>();
}

@if (string.IsNullOrEmpty(role) || role == "Client")
{
    <!-- Page d'accueil publique / Client -->
    <div class="hero-section bg-primary text-center py-5 mb-5 rounded">
        <div class="container">
            <h1 class="display-3 fw-bold mb-3 text-dark">Bienvenue chez Farma</h1>
            <p class="lead mb-4 text-dark">Votre parapharmacie de confiance pour tous vos besoins en santé et bien-être</p>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a href="@Url.Action("Index", "Catalog")" class="btn btn-light btn-lg px-4">
                    📦 Voir le catalogue
                </a>
                <a href="@Url.Action("Index", "Cart")" class="btn btn-outline-light btn-lg px-4">
                    🛒 Mon panier
                </a>
            </div>
        </div>
    </div>

    <div class="container mb-5">
        <div class="row">
            <div class="col-md-6 mx-auto">
                <div class="card shadow-sm">
                    <div class="card-body p-3">
                        <h3 class="card-title mb-3 text-dark">Rechercher un produit</h3>
                        <form method="get" asp-controller="Catalog" asp-action="Index" class="d-flex">
                            <input type="text" name="search" class="form-control me-2" placeholder="Nom, référence ou description..." />
                            <button type="submit" class="btn btn-primary px-3">
                                🔍 Rechercher
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Produits en vedette -->
    <div class="container mb-5">
        <h2 class="text-center mb-4">Produits en vedette</h2>
        <div class="row">
            @foreach (var product in products.Take(4))
            {
                <div class="col-md-3 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 200px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/300x200?text=@Uri.EscapeDataString(product.Name)'" />
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                <span class="text-muted">Pas d'image</span>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@product.Name</h5>
                            <p class="card-text text-primary fw-bold fs-5">@product.Price.ToString("0.00") €</p>
                            <div class="mt-auto">
                                @if (product.Stock > 0)
                                {
                                    <form method="post" asp-controller="Cart" asp-action="AddToCart">
                                        <input type="hidden" name="productId" value="@product.Id" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="btn btn-primary w-100">Ajouter au panier</button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-secondary w-100" disabled>Rupture de stock</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="text-center mt-4">
            <a href="@Url.Action("Index", "Catalog")" class="btn btn-outline-primary btn-lg">Voir tout le catalogue</a>
        </div>
    </div>
}
else
{
    <!-- Tableau de bord pour les employés -->
    <h1 class="mb-4">Tableau de bord</h1>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-bg-light">
                <div class="card-body">
                    <div class="fs-4">@products.Count()</div>
                    <div>Produits actifs</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-bg-light">
                <div class="card-body">
                    <div class="fs-4">@customers.Count()</div>
                    <div>Clients</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-bg-light">
                <div class="card-body">
                    <div class="fs-4">@sales.Count()</div>
                    <div>Ventes enregistrées</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-bg-light">
                <div class="card-body">
                    <div class="fs-4">@supplierOrders.Count()</div>
                    <div>Commandes fournisseurs</div>
                </div>
            </div>
        </div>
    </div>

    @if (role == "Admin")
    {
        <div class="alert alert-info">
            Vous êtes connecté en tant qu'Administrateur : gérez les utilisateurs, catégories et paramètres.
        </div>
    }

    <h4 class="text-dark">Stocks à surveiller</h4>
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Produit</th>
                <th>Stock</th>
                <th>Seuil</th>
            </tr>
        </thead>
        <tbody>
            @{
                var lowStock = products.Where(p => p.Stock <= p.ReorderLevel).ToList();
            }
            @if (!lowStock.Any())
            {
                <tr><td colspan="3">Aucun produit en alerte.</td></tr>
            }
            else
            {
                foreach (var p in lowStock)
                {
                    <tr>
                        <td>@p.Name</td>
                        <td>@p.Stock</td>
                        <td>@p.ReorderLevel</td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <a class="btn btn-primary" asp-controller="Sales" asp-action="Create">Enregistrer une vente</a>
    <a class="btn btn-outline-primary" asp-controller="SupplierOrders" asp-action="Create">Commander chez un fournisseur</a>
}
